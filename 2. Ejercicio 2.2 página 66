from enum import Enum

# 1. Definición del Enumerador para el tipo de planeta
class TipoPlaneta(Enum):
    GASEOSO = "Gaseoso"
    TERRESTRE = "Terrestre"
    ENANO = "Enano"

class Planeta:
    # 2. Constructor con valores por defecto (cumpliendo las reglas de inicialización)
    def __init__(self, nombre=None, cantidad_satelites=0, masa_kg=0.0,volumen_km3=0.0, diametro_km=0, distancia_sol_millones_km=0,
                 tipo=TipoPlaneta.TERRESTRE, observable=False,periodo_orbital_anios=0.0, periodo_rotacion_dias=0.0):

        self.nombre = nombre
        self.cantidad_satelites = cantidad_satelites
        self.masa_kg = masa_kg
        self.volumen_km3 = volumen_km3
        self.diametro_km = diametro_km
        self.distancia_sol_millones_km = distancia_sol_millones_km
        self.tipo = tipo
        self.observable = observable

        # Nuevos atributos del Ejercicios propuestos
        self.periodo_orbital_anios = periodo_orbital_anios
        self.periodo_rotacion_dias = periodo_rotacion_dias

    # 3. Método para imprimir todos los atributos
    def imprimir(self):
        print(f"\n### Planeta: {self.nombre} ###")
        print(f"Satélites: {self.cantidad_satelites}")
        print(f"Masa: {self.masa_kg} kg")
        print(f"Volumen: {self.volumen_km3} km³")
        print(f"Diámetro: {self.diametro_km} km")
        print(f"Distancia al Sol: {self.distancia_sol_millones_km} millones de km")
        print(f"Tipo: {self.tipo.value}")  # Usamos .value para obtener el texto del Enum
        print(f"Observable a simple vista: {'Sí' if self.observable else 'No'}")
        print(f"Periodo Orbital: {self.periodo_orbital_anios} años")
        print(f"Periodo de Rotación: {self.periodo_rotacion_dias} días")

    # 4. Método para calcular densidad
    def calcular_densidad(self):
        if self.volumen_km3 == 0:
            return 0.0
        return self.masa_kg / self.volumen_km3

    # 5. Método para determinar si es exterior
    def es_exterior(self):
        # 1 UA = 149597870 Km
        # Un planeta es exterior si está más allá del cinturón (límite > 3.4 UA)
        limite_exterior_km = 3.4 * 149597870

        # El atributo del planeta está en MILLONES de km, así que lo multiplicamos por 1,000,000
        distancia_real_km = self.distancia_sol_millones_km * 1_000_000

        return distancia_real_km > limite_exterior_km

# 6. Bloque Main
if __name__ == "__main__":
    # Creamos a Júpiter (Planeta exterior y Gaseoso)
    # Usamos notación científica (ej. 1.898e27) por ser números muy grandes
    jupiter = Planeta(
        nombre="Júpiter",
        cantidad_satelites=95,
        masa_kg=1.898e27,
        volumen_km3=1.431e15,
        diametro_km=139820,
        distancia_sol_millones_km=778,
        tipo=TipoPlaneta.GASEOSO,
        observable=True,
        periodo_orbital_anios=11.86,
        periodo_rotacion_dias=0.41
    )

    # Creamos a la Tierra (Planeta interior y Terrestre)
    tierra = Planeta(
        nombre="Tierra",
        cantidad_satelites=1,
        masa_kg=5.972e24,
        volumen_km3=1.083e12,
        diametro_km=12742,
        distancia_sol_millones_km=149, # Aprox 1 UA (149 millones de km)
        tipo=TipoPlaneta.TERRESTRE,
        observable=True,
        periodo_orbital_anios=1.0,
        periodo_rotacion_dias=1.0
    )

    # Mostramos los valores de los atributos usando el método
    jupiter.imprimir()
    tierra.imprimir()

    # Mostramos densidad y si es exterior
    print("\n### Cálculos de Júpiter ###")
    print(f"Densidad: {jupiter.calcular_densidad():.2e} kg/km³")
    print(f"¿Es un planeta exterior?: {'Sí' if jupiter.es_exterior() else 'No'}")

    print("\n### Cálculos de la Tierra ###")
    print(f"Densidad: {tierra.calcular_densidad():.2e} kg/km³")
    print(f"¿Es un planeta exterior?: {'Sí' if tierra.es_exterior() else 'No'}")
