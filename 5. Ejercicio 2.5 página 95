from enum import Enum

# Definimos el tipo de cuenta usando Enum para evitar errores de escritura
class TipoCuenta(Enum):
    AHORROS = "Ahorros de bajo riesgo"
    CORRIENTE = "Corriente transaccional"

class CuentaBancaria:
    def __init__(self, nombres, apellidos, numero_cuenta, tipo_cuenta, porcentaje_interes_mensual=0.0):
        self.nombres = nombres
        self.apellidos = apellidos
        self.numero_cuenta = numero_cuenta
        self.tipo_cuenta = tipo_cuenta

        # El saldo se inicializa obligatoriamente en 0.
        # Lo hacemos "privado" para que solo los métodos internos puedan modificarlo.
        self.__saldo = 0.0

        # Atributo del ejercicio propuesto
        self.porcentaje_interes_mensual = porcentaje_interes_mensual

    # Métodos de la cuenta
    def consultar_saldo(self):
        return self.__saldo

    def consignar(self, valor):
        if valor > 0:
            self.__saldo += valor
            print(f"Consignación exitosa: +${valor}. Nuevo saldo: ${self.__saldo}")
        else:
            print("Error: El valor a consignar debe ser mayor a cero.")

    def retirar(self, valor):
        if valor <= 0:
            print("Error: El valor a retirar debe ser mayor a cero.")
        elif valor > self.__saldo:
            # Validación clave solicitada en el enunciado
            print(f"Fondos insuficientes. Intentas retirar ${valor} pero tu saldo es ${self.__saldo}")
        else:
            self.__saldo -= valor
            print(f"Retiro exitoso: -${valor}. Nuevo saldo: ${self.__saldo}")

    # Método del ejercicio propuesto
    def aplicar_interes(self):
        # Calculamos el incremento basándonos en el porcentaje
        interes_generado = self.__saldo * (self.porcentaje_interes_mensual / 100)
        self.__saldo += interes_generado
        # Usamos :.2f para mostrar solo dos decimales
        print(f" Interés aplicado ({self.porcentaje_interes_mensual}%): +${interes_generado:.2f}. Nuevo saldo: ${self.__saldo:.2f}")

    def imprimir(self):
        print("\n--- Estado de la Cuenta Bancaria ---")
        print(f"Titular: {self.nombres} {self.apellidos}")
        print(f"Número de Cuenta: {self.numero_cuenta}")
        print(f"Tipo de Cuenta: {self.tipo_cuenta.value}")
        print(f"Tasa de Interés: {self.porcentaje_interes_mensual}%")
        print(f"Saldo Actual: ${self.__saldo:.2f}")

if __name__ == "__main__":
    # 1. Creamos la cuenta bancaria
    mi_cuenta = CuentaBancaria(
        nombres="Pedro",
        apellidos="Perez",
        numero_cuenta="123456789",
        tipo_cuenta=TipoCuenta.AHORROS,
        porcentaje_interes_mensual=1.5
    )

    # 2. Mostramos el estado inicial (saldo en 0)
    mi_cuenta.imprimir()

    # 3. Probamos la lógica de la clase
    print("--- Realizando transacciones ---")
    mi_cuenta.consignar(150000)

    # Intentamos retirar más de lo que hay para probar la validación
    mi_cuenta.retirar(200000)

    # Retiro normal
    mi_cuenta.retirar(50000)

    # 4. Aplicamos el interés sobre el saldo restante (100000)
    mi_cuenta.aplicar_interes()

    # 5. Estado final
    mi_cuenta.imprimir()
