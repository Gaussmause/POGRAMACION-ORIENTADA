from enum import Enum

#tipos de combustibles
class TipoCombustible(Enum):
    GASOLINA = "Gasolina"
    BIOETANOL = "Bioetanol"
    DIESEL = "Diesel"
    BIODIESEL = "Biodiesel"
    GAS_NATURAL = "Gas natural"

#tipos de carro
class TipoAutomovil(Enum):
    CIUDAD = "Ciudad"
    SUBCOMPACTO = "Subcompacto"
    COMPACTO = "Compacto"
    FAMILIAR = "Familiar"
    EJECUTIVO = "Ejecutivo"
    SUV = "SUV"

#colores
class TipoColor(Enum):
    BLANCO = "Blanco"
    NEGRO = "Negro"
    ROJO = "Rojo"
    NARANJA = "Naranja"
    AMARILLO = "Amarillo"
    VERDE = "Verde"
    AZUL = "Azul"
    VIOLETA = "Violeta"

class Automovil:
    # Carro completo
    def __init__(self, marca, modelo, motor, combustible, tipo, puertas, asientos, vel_max, color):
        self.marca = marca
        self.modelo = modelo
        self.motor = motor
        self.combustible = combustible
        self.tipo = tipo
        self.puertas = puertas
        self.asientos = asientos
        self.velocidad_maxima = vel_max
        self.color = color
        self.velocidad_actual = 0 #em´pieza desde cero por defecto

    #aceleración y frenado
    def acelerar(self, incremento):
        if self.velocidad_actual + incremento <= self.velocidad_maxima:
            self.velocidad_actual += incremento
        else:
            print("No se puede superar la velocidad máxima permitida.")

    def desacelerar(self, decremento):
        if self.velocidad_actual - decremento >= 0:
            self.velocidad_actual -= decremento
        else:
            print("No se puede desacelerar a una velocidad negativa.")

    def frenar(self):
        self.velocidad_actual = 0

    #calcular tiempo de llegada
    def calcular_tiempo_llegada(self, distancia):
        if self.velocidad_actual == 0:
            return float('inf')  # No llega nunca si está parado
        return distancia / self.velocidad_actual

    #datos del estado actual
    def imprimir(self):
        print(f"Marca: {self.marca}")
        print(f"Modelo: {self.modelo}")
        print(f"Motor: {self.motor} litros")
        print(f"Combustible: {self.combustible.value}")
        print(f"Tipo: {self.tipo.value}")
        print(f"Puertas: {self.puertas}")
        print(f"Asientos: {self.asientos}")
        print(f"Velocidad Máxima: {self.velocidad_maxima} km/h")
        print(f"Color: {self.color.value}")
        print(f"Velocidad Actual: {self.velocidad_actual} km/h")


#se piden datos basicos
marca = input("Ingrese la marca: ")
modelo = int(input("Ingrese el modelo (año): "))
motor = float(input("Ingrese el cilindraje del motor (litros): "))
puertas = int(input("Ingrese el número de puertas: "))
asientos = int(input("Ingrese la cantidad de asientos: "))
vel_max = int(input("Ingrese la velocidad máxima (km/h): "))

#combustible,tipo y color
print("\nTipos de combustible: GASOLINA, BIOETANOL, DIESEL, BIODIESEL, GAS_NATURAL")
combustible_str = input("Seleccione el combustible: ").upper()
combustible = TipoCombustible[combustible_str]

print("\nTipos de automóvil: CIUDAD, SUBCOMPACTO, COMPACTO, FAMILIAR, EJECUTIVO, SUV")
tipo_str = input("Seleccione el tipo de auto: ").upper()
tipo_auto = TipoAutomovil[tipo_str]

print("\nColores: BLANCO, NEGRO, ROJO, NARANJA, AMARILLO, VERDE, AZUL, VIOLETA")
color_str = input("Seleccione el color: ").upper()
color_auto = TipoColor[color_str]

#La instancia
auto1 = Automovil(marca, modelo, motor, combustible,
                  tipo_auto, puertas, asientos, vel_max, color_auto)

print("\nEl automóvil es:")
auto1.imprimir()
#velocidad inicial en 100 km/h
auto1.velocidad_actual = 100
print(f"Velocidad actual = {auto1.velocidad_actual} km/h")

#Se aumenta velocidad en 20 km/h
auto1.acelerar(20)
print(f"Velocidad actual = {auto1.velocidad_actual} km/h")

#Se reduce velocidad en 50 km/h
auto1.desacelerar(50)
print(f"Velocidad actual = {auto1.velocidad_actual} km/h")

#Se frena
auto1.frenar()
print(f"Velocidad actual = {auto1.velocidad_actual} km/h")

