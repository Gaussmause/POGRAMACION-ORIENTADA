from enum import Enum

# 1. Definimos los Enumeradores
class TipoCombustible(Enum):
    GASOLINA = "Gasolina"
    BIOETANOL = "Bioetanol"
    DIESEL = "Diésel"
    BIODIESEL = "Biodiésel"
    GAS_NATURAL = "Gas natural"

class TipoAutomovil(Enum):
    CIUDAD = "Carro de ciudad"
    SUBCOMPACTO = "Subcompacto"
    COMPACTO = "Compacto"
    FAMILIAR = "Familiar"
    EJECUTIVO = "Ejecutivo"
    SUV = "SUV"

class Color(Enum):
    BLANCO = "Blanco"
    NEGRO = "Negro"
    ROJO = "Rojo"
    NARANJA = "Naranja"
    AMARILLO = "Amarillo"
    VERDE = "Verde"
    AZUL = "Azul"
    VIOLETA = "Violeta"

class Automovil:
    # 2. Constructor
    def __init__(self, marca, modelo, motor, tipo_combustible, tipo_automovil,
                 num_puertas, cant_asientos, vel_maxima, color, es_automatico=True):
        # Atributos protegidos con __
        self.__marca = marca
        self.__modelo = modelo
        self.__motor = motor
        self.__tipo_combustible = tipo_combustible
        self.__tipo_automovil = tipo_automovil
        self.__num_puertas = num_puertas
        self.__cant_asientos = cant_asientos
        self.__vel_maxima = vel_maxima
        self.__color = color
        self.__velocidad_actual = 0.0

        # Nuevos atributos del Ejercicios propuestos
        self.__es_automatico = es_automatico
        self.__valor_total_multas = 0.0
        self.__cantidad_multas = 0

    # 3. Métodos Get y Set
    def get_velocidad_actual(self):
        return self.__velocidad_actual

    def set_velocidad_actual(self, velocidad):
        if velocidad <= self.__vel_maxima:
            self.__velocidad_actual = velocidad
        else:
            self.__velocidad_actual = self.__vel_maxima
            print(f"Error: No puedes establecer una velocidad mayor a la máxima ({self.__vel_maxima} km/h).")

    # Get y Set propuestos para el atributo es_automatico
    def get_es_automatico(self):
        return self.__es_automatico

    def set_es_automatico(self, valor_booleano):
        self.__es_automatico = valor_booleano

    # 4. Métodos de control de velocidad y multas (Ejercicios propuestos)
    def acelerar(self, incremento):
        nueva_velocidad = self.__velocidad_actual + incremento

        if nueva_velocidad > self.__vel_maxima:
            self.__velocidad_actual = self.__vel_maxima
            # Generamos la multa según el ejercicio propuesto
            valor_multa = 150000.0  # Un valor fijo de ejemplo
            self.__cantidad_multas += 1
            self.__valor_total_multas += valor_multa
            print(f"INFRACCIÓN Intentó acelerar a {nueva_velocidad} km/h superando el límite de {self.__vel_maxima} km/h.")
            print(f"Se ha generado una multa de ${valor_multa}. Total acumulado: ${self.__valor_total_multas}")
        else:
            self.__velocidad_actual = nueva_velocidad
            print(f"Acelerando, velocidad actual: {self.__velocidad_actual} km/h")

    def desacelerar(self, decremento):
        nueva_velocidad = self.__velocidad_actual - decremento

        if nueva_velocidad < 0:
            self.__velocidad_actual = 0
            print("No es posible desacelerar a una velocidad negativa. El vehículo se ha detenido.")
        else:
            self.__velocidad_actual = nueva_velocidad
            print(f"Desacelerando: velocidad actual: {self.__velocidad_actual} km/h")

    def frenar(self):
        self.__velocidad_actual = 0
        print("Frenado total. Velocidad actual: 0 km/h")

    def tiempo_estimado_llegada(self, distancia_km):
        if self.__velocidad_actual == 0:
            return "El vehículo está detenido. Tiempo de llegada infinito."
        tiempo = distancia_km / self.__velocidad_actual
        return f"Tiempo estimado: {tiempo:.2f} horas"

    # Métodos para las multas
    def tiene_multas(self):
        return self.__cantidad_multas > 0

    def total_multas(self):
        return self.__valor_total_multas

    # 5. Método Imprimir
    def imprimir(self):
        print("\n### Especificaciones del Automóvil ###")
        print(f"Marca: {self.__marca} / Modelo: {self.__modelo} / Motor: {self.__motor}L")
        print(f"Tipo: {self.__tipo_automovil.value} / Combustible: {self.__tipo_combustible.value}")
        print(f"Color: {self.__color.value} / Transmisión Automática: {'Sí' if self.__es_automatico else 'No'}")
        print(f"Puertas: {self.__num_puertas} / Asientos: {self.__cant_asientos}")
        print(f"Velocidad Máxima: {self.__vel_maxima} km/h")
        print(f"Velocidad Actual: {self.__velocidad_actual} km/h")
        print("\n")

# 6. Método Main
if __name__ == "__main__":
    # Creamos un automóvil con velocidad máxima de 110 km/h
    mi_carro = Automovil(
        marca="Ford",
        modelo=2018,
        motor=3,
        tipo_combustible=TipoCombustible.GASOLINA,
