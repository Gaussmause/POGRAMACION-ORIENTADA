import math

# 1. Clase Círculo
class Circulo:
    def __init__(self, radio):
        self.radio = radio

    def calcular_area(self):
        # Fórmula: pi * r^2
        return math.pi * (self.radio ** 2)

    def calcular_perimetro(self):
        # Fórmula: 2 * pi * r
        return 2 * math.pi * self.radio

# 2. Clase Rectángulo
class Rectangulo:
    def __init__(self, base, altura):
        self.base = base
        self.altura = altura

    def calcular_area(self):
        return self.base * self.altura

    def calcular_perimetro(self):
        return 2 * (self.base + self.altura)

# 3. Clase Cuadrado
class Cuadrado:
    def __init__(self, lado):
        self.lado = lado

    def calcular_area(self):
        return self.lado ** 2

    def calcular_perimetro(self):
        return 4 * self.lado

# 4. Clase Triángulo Rectángulo
class TrianguloRectangulo:
    def __init__(self, base, altura):
        self.base = base
        self.altura = altura

    def calcular_area(self):
        return (self.base * self.altura) / 2

    def calcular_hipotenusa(self):
        # Teorema de Pitágoras: c = raíz(a^2 + b^2)
        return math.sqrt((self.base ** 2) + (self.altura ** 2))

    def calcular_perimetro(self):
        return self.base + self.altura + self.calcular_hipotenusa()

    def determinar_tipo(self):
        # En geometría euclidiana, un triángulo rectángulo NUNCA puede ser equilátero
        # porque la hipotenusa siempre es estrictamente mayor que los catetos.
        # Por lo tanto, solo puede ser Isósceles (si base y altura son iguales) o Escaleno.
        if self.base == self.altura:
            return "Isósceles"
        else:
            return "Escaleno"

# 5. Clase Rombo (Ejercicio Propuesto)
class Rombo:
    # Un rombo necesita sus dos diagonales para el área y su lado para el perímetro
    def __init__(self, diagonal_mayor, diagonal_menor, lado):
        self.diagonal_mayor = diagonal_mayor
        self.diagonal_menor = diagonal_menor
        self.lado = lado

    def calcular_area(self):
        return (self.diagonal_mayor * self.diagonal_menor) / 2

    def calcular_perimetro(self):
        return 4 * self.lado

# 6. Clase Trapecio (Ejercicio Propuesto)
class Trapecio:
    # Para un trapecio cualquiera necesitamos bases, altura y sus otros dos lados
    def __init__(self, base_mayor, base_menor, altura, lado_izquierdo, lado_derecho):
        self.base_mayor = base_mayor
        self.base_menor = base_menor
        self.altura = altura
        self.lado_izquierdo = lado_izquierdo
        self.lado_derecho = lado_derecho

    def calcular_area(self):
        return ((self.base_mayor + self.base_menor) / 2) * self.altura

    def calcular_perimetro(self):
        return self.base_mayor + self.base_menor + self.lado_izquierdo + self.lado_derecho

if __name__ == "__main__":
    print("··· Análisis de Figuras Geométricas ···")

    # Prueba del Círculo
    mi_circulo = Circulo(5)
    # Usamos {:.2f} para redondear los decimales a 2 en la impresión
    print(f"\nCírculo (radio={mi_circulo.radio}):")
    print(f"Área: {mi_circulo.calcular_area():.2f} cm² | Perímetro: {mi_circulo.calcular_perimetro():.2f} cm")

    # Prueba del Triángulo Rectángulo
    mi_triangulo = TrianguloRectangulo(3, 4)
    print(f"\nTriángulo Rectángulo (base={mi_triangulo.base}, altura={mi_triangulo.altura}):")
    print(f"Área: {mi_triangulo.calcular_area()} cm²")
    print(f"Hipotenusa: {mi_triangulo.calcular_hipotenusa()} cm")
    print(f"Perímetro: {mi_triangulo.calcular_perimetro()} cm")
    print(f"Tipo: {mi_triangulo.determinar_tipo()}")

    # Prueba del Trapecio
    mi_trapecio = Trapecio(base_mayor=10, base_menor=6, altura=4, lado_izquierdo=5, lado_derecho=5)
    print(f"\nTrapecio:")
    print(f"Área: {mi_trapecio.calcular_area()} cm² | Perímetro: {mi_trapecio.calcular_perimetro()} cm")

