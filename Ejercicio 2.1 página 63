class Persona:
    #__init__ es lo mismo q constructor en Java
    def __init__(self, nombre, apellido, numerodocumento, anonacimiento):
        self.nombre = nombre  #self es lo mismo q 'this' en Java
        self.apellido = apellido
        self.numerodocumento = numerodocumento
        self.anonacimiento = anonacimiento


    # Acá se muestraan los datos
    def mostrar_datos(self):
        print(f"Nombre = {self.nombre}")
        print(f"Apellido = {self.apellido}")
        print(f"Número documento de identidad = {self.numerodocumento}")
        print(f"Año de nacimiento = {self.anonacimiento}\n")




#En Python se usa input y no scanner
nombre = input("Ingrese el nombre: ")
apellido = input("Ingrese el apellido: ")
numerodocumento = input("Ingrese el número de documento: ")
#Se pasa a int pq input siempre devuelve texto
anonacimiento = int(input("Ingrese el año de nacimiento: "))


#La instancia
personal = Persona(nombre, apellido, numerodocumento, anonacimiento)
